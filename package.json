{
  "name": "signalk-container-helper",
  "version": "0.6.0",
  "description": "Helper library for Signal K plugins that manage containers via the signalk-container plugin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run typecheck:test && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "prepublishOnly": "npm run build && npm test",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoeken/signalk-container-helper.git"
  },
  "bugs": {
    "url": "https://github.com/hoeken/signalk-container-helper/issues"
  },
  "homepage": "https://github.com/hoeken/signalk-container-helper#readme",
  "keywords": [
    "signalk",
    "signalk-container",
    "signalk-plugin",
    "docker",
    "podman",
    "container"
  ],
  "author": "hoeken",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "signalk-container": "^1.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.10"
  }
}
